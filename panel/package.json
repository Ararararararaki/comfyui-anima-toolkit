{
  "name": "anima-lora-explorer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/deploy-server.mjs & vite --host",
    "dev": "start /B node scripts/deploy-server.mjs && vite",
    "dev:server": "node scripts/deploy-server.mjs",
    "dev:host": "vite --host --port 5173",
    "build": "tsc && vite build",
    "smoke": "node scripts/smoke.mjs",
    "verify:batch-lora-weight-controls": "node scripts/verify-batch-lora-weight-controls.mjs",
    "verify:local-lora-scan": "node scripts/verify-local-lora-scan.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:base-model-catalog": "node scripts/verify-base-model-catalog.mjs",
    "verify:output-metadata": "node scripts/verify-output-metadata.mjs",
    "verify:image-metadata": "node scripts/verify-image-metadata.mjs",
    "scan:output-metadata": "node scripts/scan-output-metadata.mjs",
    "setup:comfyui": "node scripts/setup-comfyui.mjs",
    "build:comfyui": "tsc && vite build --base=/extensions/ComfyUI-Anima-Batch-LoRA/app/ --outDir dist-comfyui --emptyOutDir && node scripts/deploy-comfyui.mjs --src dist-comfyui",
    "build:comfyui:ci": "tsc && vite build --base=/extensions/ComfyUI-Anima-Batch-LoRA/app/ --outDir ../app --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "jszip": "^3.10.1",
    "lucide": "^1.27.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
